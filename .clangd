CompileFlags:
  Remove:
    - -fmodules-ts
    - -fmodule-mapper=*
    - -fdeps-format=*
    - -forward-unknown-to-host-compiler
    - -arch=native
    - -Xptxas="-v"

  Add:
    - -I/usr/local/cuda-13.3/targets/x86_64-linux/include/cccl/

Diagnostics:
  ClangTidy:
    Suppress: [deduction_guide_target_attr]
  Suppress: [deduction_guide_target_attr]
